APP_NAME="SIPANDU Rindam III/Siliwangi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rindamsiliwangi.tech

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Keamanan & Optimasi Sesi
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Database (Default: SQLite dengan WAL Mode Aman & Kencang)
DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_FOREIGN_KEYS=true

# Jika ingin beralih ke MySQL/MariaDB pada VPS:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sipandu_db
# DB_USERNAME=sipandu_user
# DB_PASSWORD=password_db_rahasia_anda

# Sesi & Keamanan Cookie (Otomatis adaptif HTTP IP & HTTPS domain)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Antrean & Cache
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Pengaturan Email (SMTP Notifikasi Sistem)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email_anda@gmail.com
MAIL_PASSWORD=app_password_rahasia
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@rindam.mil.id"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi Upload & Keamanan
MAX_UPLOAD_SIZE=51200
VITE_APP_NAME="${APP_NAME}"
